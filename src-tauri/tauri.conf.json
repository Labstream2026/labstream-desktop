{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Labstream OS",
  "version": "1.43.0",
  "identifier": "co.labstream.os",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://os.labstreamsas.com/api/herramientas/labstream-escritorio-latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RkJFM0FFREYxREYxMjQKUldRazhSM2ZydVA3S0pNc01UNVZIU3VCYmlxNFA0NjVlRklGajcwZkIxRXJWazA3U0NFZXhQMGoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Labstream SAS",
    "category": "Productivity",
    "shortDescription": "Espacio de trabajo de Labstream",
    "longDescription": "Cliente de escritorio de Labstream OS para Windows y macOS. Abre el espacio de trabajo de Labstream en su propia ventana.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "SpanishInternational",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    }
  }
}
