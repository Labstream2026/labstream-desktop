<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Textos que macOS muestra al pedir permiso. Tauri fusiona este Info.plist en el bundle. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Labstream usa el micrófono para grabar notas de voz en el chat.</string>
	<!-- macOS 15 o más nuevo pide permiso para hablar con la red propia. La app le pregunta al servidor
	     de las bibliotecas de Resolve si está, por la red de la oficina y por ZeroTier (resolve_lista.rs).
	     Sin este texto el aviso sale sin explicación, y es fácil negarlo sin saber para qué era. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Labstream comprueba si el servidor de las bibliotecas de DaVinci Resolve responde en la red de la oficina o por ZeroTier, para que abran desde donde estés.</string>
	<key>NSCameraUsageDescription</key>
	<string>Labstream usa la cámara para adjuntar fotos y video en el chat.</string>
</dict>
</plist>
