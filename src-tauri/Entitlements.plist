<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Micrófono: notas de voz del chat (getUserMedia en el webview). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Cámara: adjuntar foto/video en el chat. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Cliente de red (conecta con os.labstreamsas.com). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Requerido por WKWebView (JIT de JavaScript) bajo hardened runtime. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
