{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos del shell de escritorio: la barra local (chrome) y las pestañas remotas (tab-*).",
  "windows": [
    "main"
  ],
  "webviews": [
    "chrome",
    "tab-*"
  ],
  "remote": {
    "urls": [
      "https://os.labstreamsas.com"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "photolab://open?code=*" }] },
    "notification:default",
    "core:window:allow-start-dragging",
    "allow-ia-estado",
    "allow-ia-preparar",
    "allow-ia-sujeto",
    "allow-ia-generar",
    "allow-ia-mantener",
    "allow-ia-ruido",
    "allow-resolve-lista",
    "allow-resolve-lista-agregar"
  ]
}
